{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "none"
          }
        },
        "worktop_configurator": {
          "type": "worktop_configurator",
          "settings": {
            "show_quote_link": false
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false,
            "show_physical_stores": false
          }
        },
        "description": {
          "type": "description"
        },
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "Cut-to-size worktop",
            "text_style": "uppercase"
          }
        },
        "trust": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "ruler",
            "heading_1": "Cut to the millimetre",
            "icon_2": "truck",
            "heading_2": "UK mainland delivery",
            "icon_3": "check_mark",
            "heading_3": "Free samples"
          }
        },
        "tab_specs": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Specification",
            "icon": "clipboard",
            "content": "<ul><li>Thickness: 20mm or 30mm</li><li>Edges: straight, bullnose or bevelled, polished on all exposed sides</li><li>Maximum slab size per piece is shown under the size fields</li><li>Sink, hob and tap cut-outs available through a free quote</li></ul>"
          }
        },
        "tab_delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery and lead time",
            "icon": "truck",
            "content": "<p>Every worktop is cut to order. Most orders are ready in 7 to 10 working days and delivered by a two-person crew to UK mainland addresses. We call to book a delivery slot.</p>"
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care and warranty",
            "icon": "leaf",
            "content": "<p>Wipe with warm soapy water and a soft cloth. Avoid harsh chemicals and use a trivet under hot pans. Quartz worktops come with a 15-year manufacturer warranty.</p>"
          }
        },
        "quote_button": {
          "type": "quote_button",
          "settings": {
            "label": "",
            "note": "Cut-outs, unusual shapes or a whole kitchen? We'll price it for free."
          }
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "variant_picker",
        "worktop_configurator",
        "buy_buttons",
        "quote_button",
        "trust",
        "description",
        "tab_specs",
        "tab_delivery",
        "tab_care"
      ],
      "settings": {
        "enable_sticky_info": false,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "quote_modal": {
      "type": "quote-modal",
      "settings": {
        "heading": "Request a free quote",
        "intro": "<p>Need an unusual shape, cut-outs or a bigger run? Tell us about your project and we'll send a free, no-obligation quote.</p>",
        "show_phone": true,
        "show_timeframe": true,
        "color_scheme": "scheme-2"
      }
    }
  },
  "order": [
    "main",
    "related-products",
    "quote_modal"
  ]
}
