{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {
        "color_scheme": "scheme-1"
      }
    },
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "color_scheme": "scheme-1"
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 24,
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "enable_filtering": true,
        "filter_type": "vertical",
        "filter_show_count": 5,
        "show_price_filter": false,
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "quote_modal": {
      "type": "quote-modal",
      "settings": {
        "heading": "Request a free quote",
        "intro": "<p>Tell us your sizes, cut-outs and postcode and we'll send a free, no-obligation quote.</p>",
        "show_phone": true,
        "show_timeframe": true,
        "color_scheme": "scheme-2"
      }
    }
  },
  "order": [
    "breadcrumbs",
    "banner",
    "product-grid",
    "quote_modal"
  ]
}
