{{ 'assessment-content.css' | asset_url | stylesheet_tag }}
<section class="assessment-content page-width" id="assessment-reviews">
  <p class="brand-eyebrow">{{ 'assessment.demo_notice' | t }}</p>
  <h2>{{ section.settings.heading | escape }}</h2>
  <p>{{ 'assessment.review_notice' | t }}</p>
  <ul class="assessment-content__reviews" role="list">
    {% for block in section.blocks %}
      <li class="assessment-content__review" {{ block.shopify_attributes }}>
        <h3 class="h4">{{ block.settings.name | escape }}</h3>
        <blockquote>{{ block.settings.text | escape }}</blockquote>
        <p class="caption">{{ 'assessment.sample_number' | t: number: forloop.index }}</p>
      </li>
    {% endfor %}
  </ul>
</section>
{% schema %}
{"name":"Assessment demo reviews","max_blocks":50,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Review layout samples"}],"blocks":[{"type":"review","name":"Demo review","settings":[{"type":"text","id":"name","label":"Sample label"},{"type":"textarea","id":"text","label":"Sample text"}]}],"presets":[{"name":"Assessment demo reviews"}]}
{% endschema %}

