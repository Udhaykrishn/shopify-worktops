{%- comment -%}
  Homepage hero: the page's single H1, two calls to action and a short list of trust points.
  The right column shows the merchant's image when one is set. Without one it builds a stone
  composition from the chosen collection: a large slab (the chosen product, or the collection's first)
  and swatch chips linking to three other products, so the hero still shows real catalogue items.
{%- endcomment -%}
{{ 'home-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_collection = section.settings.collection
  assign hero_heading = section.settings.heading | default: shop.name
-%}

<div class="home-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width home-hero__inner section-{{ section.id }}-padding">
    <div class="home-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="home-hero__heading h0">{{ hero_heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="home-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="home-hero__actions">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              class="button button--primary"
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              class="button button--secondary"
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="home-hero__trust list-unstyled" role="list">
          {%- for block in section.blocks -%}
            <li class="home-hero__trust-item" {{ block.shopify_attributes }}>
              <span class="svg-wrapper" aria-hidden="true">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
              {{ block.settings.text | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="home-hero__visual">
      {%- if section.settings.image != blank -%}
        <div class="home-hero__media">
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              class: 'home-hero__image'
          }}
        </div>
      {%- elsif hero_collection != blank and hero_collection.products_count > 0 -%}
        {%- assign slab_product = section.settings.slab_product | default: hero_collection.products.first -%}
        <div class="home-hero__media home-hero__media--stone">
          {%- assign slab_uid = section.id | append: '-slab' -%}
          {% render 'worktop-stone-art', product: slab_product, uid: slab_uid, eager: true, sizes: '(min-width: 990px) 50vw, 100vw' %}
          <a class="home-hero__slab-label" href="{{ slab_product.url }}">
            <span class="home-hero__slab-name">{{ slab_product.title | escape }}</span>
            <span class="home-hero__slab-cta">{{ 'sections.home_hero.view_stone' | t }}</span>
          </a>
        </div>

        {%- if hero_collection.products_count > 1 -%}
          <ul class="home-hero__chips list-unstyled" role="list">
            {%- assign chip_count = 0 -%}
            {%- for chip_product in hero_collection.products limit: 4 -%}
              {%- if chip_product.id == slab_product.id or chip_count >= 3 -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign chip_count = chip_count | plus: 1 -%}
              <li>
                <a class="home-hero__chip" href="{{ chip_product.url }}">
                  <span class="home-hero__chip-swatch">
                    {%- assign chip_uid = section.id | append: '-chip-' | append: chip_product.id -%}
                    {% render 'worktop-stone-art', product: chip_product, uid: chip_uid %}
                  </span>
                  <span class="home-hero__chip-name">{{ chip_product.title | escape }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      {%- else -%}
        <div class="home-hero__media home-hero__media--stone">
          {% render 'worktop-stone-art', tone: '#efebe4', uid: section.id %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.home_hero.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "t:sections.home_hero.settings.eyebrow.default",
      "label": "t:sections.home_hero.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "t:sections.home_hero.settings.heading.default",
      "label": "t:sections.home_hero.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "t:sections.home_hero.settings.text.default",
      "label": "t:sections.home_hero.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "default": "t:sections.home_hero.settings.button_label_1.default",
      "label": "t:sections.home_hero.settings.button_label_1.label"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "t:sections.home_hero.settings.button_link_1.label"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "default": "t:sections.home_hero.settings.button_label_2.default",
      "label": "t:sections.home_hero.settings.button_label_2.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.home_hero.settings.button_link_2.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.home_hero.settings.image.label",
      "info": "t:sections.home_hero.settings.image.info"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.home_hero.settings.collection.label",
      "info": "t:sections.home_hero.settings.collection.info"
    },
    {
      "type": "product",
      "id": "slab_product",
      "label": "t:sections.home_hero.settings.slab_product.label",
      "info": "t:sections.home_hero.settings.slab_product.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "t:sections.home_hero.blocks.trust_item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.home_hero.blocks.trust_item.settings.text.default",
          "label": "t:sections.home_hero.blocks.trust_item.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.home_hero.presets.name",
      "blocks": [{ "type": "trust_item" }, { "type": "trust_item" }, { "type": "trust_item" }]
    }
  ]
}
{% endschema %}
