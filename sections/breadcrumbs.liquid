{%- comment -%}
  Breadcrumb trail for collection and product pages: Home › Collection › Product. The same trail is output
  as BreadcrumbList JSON-LD, so the structured data always matches what shoppers see.
  On a product reached outside a collection, the first collection other than the home page one is used.
{%- endcomment -%}
<style>{{ 'section-breadcrumbs.css' | inline_asset_content }}</style>

{%- liquid
  assign separator = '|~|'
  assign home_label = 'general.breadcrumbs.home' | t
  assign crumb_names = home_label
  assign crumb_urls = routes.root_url

  assign trail_collection = collection
  if request.page_type == 'product' and trail_collection == blank
    for product_collection in product.collections
      if product_collection.handle != 'frontpage'
        assign trail_collection = product_collection
        break
      endif
    endfor
  endif

  if trail_collection != blank
    assign crumb_names = crumb_names | append: separator | append: trail_collection.title
    assign crumb_urls = crumb_urls | append: separator | append: trail_collection.url
  endif
  if request.page_type == 'product'
    assign crumb_names = crumb_names | append: separator | append: product.title
    assign crumb_urls = crumb_urls | append: separator | append: product.url
  endif

  assign crumb_names = crumb_names | split: separator
  assign crumb_urls = crumb_urls | split: separator
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <nav class="breadcrumbs page-width" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <ol class="breadcrumbs__list list-unstyled" role="list">
      {%- for name in crumb_names -%}
        {%- assign index = forloop.index0 -%}
        <li class="breadcrumbs__item">
          {%- if forloop.last -%}
            <span class="breadcrumbs__current" aria-current="page">{{ name | escape }}</span>
          {%- else -%}
            <a class="breadcrumbs__link link" href="{{ crumb_urls[index] }}">{{ name | escape }}</a>
            <span class="breadcrumbs__separator" aria-hidden="true">/</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </nav>
</div>

{%- if crumb_names.size > 1 -%}
  {% render 'structured-data-breadcrumb', names: crumb_names, urls: crumb_urls %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.breadcrumbs.name",
  "class": "section-breadcrumbs",
  "enabled_on": {
    "templates": ["collection", "product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.breadcrumbs.name"
    }
  ]
}
{% endschema %}
