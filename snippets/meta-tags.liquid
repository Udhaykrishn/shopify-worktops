{%- doc -%}
  Renders Open Graph and Twitter metadata for the current page.

  @param {string} [seo_description] - The resolved document description.
  @param {string} [seo_canonical] - The resolved document canonical URL.

  @example
  {% render 'meta-tags' %}
{%- enddoc -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = seo_canonical | default: canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description | default: shop.name
  assign social_image = page_image | default: product.featured_image

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url | escape }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if social_image -%}
  <meta property="og:image" content="https:{{ social_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ social_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ social_image.width | at_most: 1200 }}">
{%- elsif request.page_type == 'product' -%}
  {%- capture artwork_url -%}{% render 'worktop-art-url', product: product %}{%- endcapture -%}
  {%- if artwork_url != blank -%}
    <meta property="og:image" content="https:{{ artwork_url | escape }}">
    <meta property="og:image:secure_url" content="https:{{ artwork_url | escape }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="1200">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    capture is_worktop
      render 'worktop-is-worktop', product: product
    endcapture
    assign og_price = product.price | divided_by: 100.0
    if is_worktop == 'true'
      # Worktop variants bill 0.01 square metre; social metadata shows the rate per square metre.
      assign og_price = product.price | times: 100 | divided_by: 100.0
    endif
  -%}
  <meta property="og:price:amount" content="{{ og_price }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
